{
  "name": "father-son-projects",
  "version": "1.0.0",
  "private": true,
  "description": "Father & Son Project Discussion Website",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "deploy": "npm run build && cd infra && npm run deploy",
    "destroy": "cd infra && npm run destroy",
    "seed": "node scripts/seed-users.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1032.0",
    "@aws-sdk/lib-dynamodb": "^3.1032.0"
  }
}
